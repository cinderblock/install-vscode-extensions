{
  "name": "install-vscode-extensions",
  "version": "1.1.0",
  "description": "CLI that installs a package's recommended VS Code extensions (from .vscode/extensions.json)",
  "type": "module",
  "bin": {
    "install-vscode-extensions": "./dist/ive.js",
    "ive": "./dist/ive.js"
  },
  "files": [
    "dist/ive.js",
    "dist/ive.js.map",
    "dist/ive.d.ts",
    "dist/ive.d.ts.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/ive.test.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/install-vscode-extensions.git"
  },
  "keywords": [
    "vscode",
    "extensions",
    "cli",
    "postinstall",
    "developer-environment"
  ],
  "author": "Cameron Tacklind <cameron@tacklind.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cinderblock/install-vscode-extensions/issues"
  },
  "homepage": "https://github.com/cinderblock/install-vscode-extensions#readme",
  "dependencies": {
    "which": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/which": "^3.0.4",
    "typescript": "^6.0.3"
  }
}
